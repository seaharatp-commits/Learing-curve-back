generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  preferredPositionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSessions    ChatSession[]
  knowledgeBaseArticles KnowledgeBaseArticle[] @relation("KbAuthor")
  quizAttempts    QuizAttempt[]
  lessonProgress  LessonProgress[]
  createdLessons  Lesson[] @relation("LessonCreator")
  createdQuizzes  Quiz[] @relation("QuizCreator")
  skillScores      UserSkillScore[]
  skillScoreEvents SkillScoreEvent[]
  careerAlignments CareerAlignment[]
  preferredPosition Position? @relation("PreferredUserPosition", fields: [preferredPositionId], references: [id], onDelete: SetNull)

  @@index([preferredPositionId])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  knowledgeBaseArticles KnowledgeBaseArticle[]

  @@map("categories")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  content   String
  sourceType String?
  sourceArticleId String?
  sourceArticleTitle String?
  sourceConfidenceScore Float?
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model KnowledgeBaseArticle {
  id         String   @id @default(uuid())
  title      String
  content    String
  categoryId String
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Structured fields populated by the AI ticket->KB learning pipeline.
  // Null/empty for articles created by hand through the admin UI.
  summary      String?
  symptoms     String?
  environment  String?
  rootCause    String?
  resolution   String?
  verification String?
  keywords     String[] @default([])
  tags         String[] @default([])

  // Verbatim text the contributor originally wrote, before AI restructuring.
  // Preserved for provenance/audit — never overwritten, only appended to on merge.
  originalText String?

  category     Category      @relation(fields: [categoryId], references: [id])
  author       User?         @relation("KbAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  generatedQuizzes Quiz[]

  @@index([categoryId])
  @@map("knowledge_base_articles")
}

model Lesson {
  id        String   @id @default(uuid())
  createdByUserId String?
  title     String
  content   String   @default("")
  order     Int
  createdAt DateTime @default(now())

  createdBy User? @relation("LessonCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  quizzes  Quiz[]
  progress LessonProgress[]

  @@index([createdByUserId])
  @@map("lessons")
}

model Quiz {
  id              String   @id @default(uuid())
  createdByUserId String?
  lessonId        String?
  sourceArticleId String?
  title           String
  createdAt       DateTime @default(now())

  createdBy     User?                 @relation("QuizCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lesson        Lesson?               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sourceArticle KnowledgeBaseArticle? @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)
  questions     Question[]
  attempts      QuizAttempt[]

  @@index([createdByUserId])
  @@index([lessonId])
  @@index([sourceArticleId])
  @@map("quizzes")
}

model Question {
  id           String   @id @default(uuid())
  quizId       String
  questionText String
  options      String[]
  correctIndex Int
  explanation  String?
  createdAt    DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  skillMappings QuizQuestionSkill[]

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  lessonId    String?
  score       Int
  selectedAnswers Json     @default("[]")
  correctAnswers  Json     @default("[]")
  result          Json     @default("{}")
  submittedAt DateTime @default(now())
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([userId, submittedAt])
  @@index([quizId, submittedAt])
  @@map("quiz_attempts")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Position {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills           PositionSkill[]
  userSkillScores  UserSkillScore[]
  skillScoreEvents SkillScoreEvent[]
  careerAlignments CareerAlignment[]
  preferredByUsers User[] @relation("PreferredUserPosition")

  @@map("positions")
}

model PositionSkill {
  id          String   @id @default(uuid())
  positionId  String
  name        String
  description String?
  keywords    String[] @default([])
  weight      Float    @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position         Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userSkillScores  UserSkillScore[]
  skillScoreEvents SkillScoreEvent[]
  questionMappings QuizQuestionSkill[]

  @@unique([positionId, name])
  @@index([positionId])
  @@map("position_skills")
}

model UserSkillScore {
  id            String   @id @default(uuid())
  userId        String
  positionId    String
  skillId       String
  score         Float    @default(0)
  evidenceCount Int      @default(0)
  /// Running 0-1 confidence that `score` reflects the learner's real level.
  /// Lowered on a first wrong answer before score itself is touched.
  confidence    Float    @default(0.5)
  /// Consecutive wrong answers for this skill; resets to 0 on a correct answer.
  wrongStreak   Int      @default(0)
  /// Extra progress accrued once score is capped at 100, so continued
  /// correct answers still register instead of being silently discarded.
  masteryPoint  Float    @default(0)
  updatedAt     DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill    PositionSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId, positionId])
  @@map("user_skill_scores")
}

model SkillScoreEvent {
  id          String   @id @default(uuid())
  userId      String
  positionId  String
  skillId     String
  sourceType  String
  sourceId    String?
  scoreDelta  Float
  scoreBefore Float
  scoreAfter  Float
  confidence  Float?
  reason      String?
  createdAt   DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill    PositionSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([skillId])
  @@map("skill_score_events")
}

// Cached AI-generated Career Alignment card content, keyed per user+position.
// Regenerated only when skillScoreHash changes (i.e. the user's skill scores
// actually moved), so the dashboard does not call the AI on every refresh.
model CareerAlignment {
  id               String   @id @default(uuid())
  userId           String
  positionId       String
  /// sum(user_skill_scores.score) for the position — reference/debugging only.
  scoreSumSnapshot Float    @default(0)
  /// "skillId:score|skillId:score|..." — the cache-invalidation key.
  skillScoreHash   String
  alignmentScore   Float    @default(0)
  level            String
  description      String
  strengths        String[] @default([])
  nextSteps        String[] @default([])
  /// "ai" when the description came from the AI Center, "fallback" otherwise.
  generatedBy      String   @default("fallback")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
  @@map("career_alignment")
}

model QuizQuestionSkill {
  id         String @id @default(uuid())
  questionId String
  skillId    String
  weight     Float  @default(1)

  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    PositionSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([questionId, skillId])
  @@index([skillId])
  @@map("quiz_question_skills")
}
