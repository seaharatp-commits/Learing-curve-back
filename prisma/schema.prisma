generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSessions    ChatSession[]
  issues          IssueReport[]
  knowledgeBaseArticles KnowledgeBaseArticle[] @relation("KbAuthor")
  quizAttempts    QuizAttempt[]
  lessonProgress  LessonProgress[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  issues               IssueReport[]
  knowledgeBaseArticles KnowledgeBaseArticle[]

  @@map("categories")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model IssueReport {
  id          String        @id @default(uuid())
  title       String
  description String
  categoryId  String
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  reporterId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  knowledgeBaseArticleId String?

  category             Category              @relation(fields: [categoryId], references: [id])
  reporter             User                  @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  knowledgeBaseArticle KnowledgeBaseArticle? @relation(fields: [knowledgeBaseArticleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoryId])
  @@map("issue_reports")
}

model KnowledgeBaseArticle {
  id         String   @id @default(uuid())
  title      String
  content    String
  categoryId String
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Structured fields populated by the AI ticket->KB learning pipeline.
  // Null/empty for articles created by hand through the admin UI.
  summary      String?
  symptoms     String?
  environment  String?
  rootCause    String?
  resolution   String?
  verification String?
  keywords     String[] @default([])
  tags         String[] @default([])

  // Verbatim text the contributor originally wrote, before AI restructuring.
  // Preserved for provenance/audit — never overwritten, only appended to on merge.
  originalText String?

  category     Category      @relation(fields: [categoryId], references: [id])
  author       User?         @relation("KbAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  sourceIssues IssueReport[]
  generatedQuizzes Quiz[]

  @@index([categoryId])
  @@map("knowledge_base_articles")
}

model Lesson {
  id        String   @id @default(uuid())
  title     String
  order     Int
  createdAt DateTime @default(now())

  quizzes  Quiz[]
  progress LessonProgress[]

  @@map("lessons")
}

model Quiz {
  id              String   @id @default(uuid())
  lessonId        String?
  sourceArticleId String?
  title           String
  createdAt       DateTime @default(now())

  lesson        Lesson?               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sourceArticle KnowledgeBaseArticle? @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)
  questions     Question[]
  attempts      QuizAttempt[]

  @@index([lessonId])
  @@index([sourceArticleId])
  @@map("quizzes")
}

model Question {
  id           String   @id @default(uuid())
  quizId       String
  questionText String
  options      String[]
  correctIndex Int
  explanation  String?
  createdAt    DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("quiz_attempts")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}
